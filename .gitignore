# Ignore local Terraform working data and the provider lock file.
.terraform/
.terraform.lock.hcl

# Ignore local Terraform state files.
*.tfstate
*.tfstate.*

# Ignore Terraform crash logs and other log files.
crash.log
*.log

# Ignore local Terraform variable files.
*.tfvars
*.tfvars.json

# Ignore local environment files.
.env
.env.*
